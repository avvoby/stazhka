# ─── Telegram Bot ────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_WEBHOOK_URL=https://yourdomain.com/webhook
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here

# ─── Telegram MTProto (для парсинга каналов — опционально) ───────────────────
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Каналы через запятую (без @): stazki_ru,stazhirovki,hh_internships
TELEGRAM_CHANNELS=

# ─── OpenRouter (Claude) ──────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MAX_TOKENS=4096

# ─── SuperJob API (опционально) ───────────────────────────────────────────────
SUPERJOB_API_KEY=

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=stazka
POSTGRES_USER=stazka_user
POSTGRES_PASSWORD=stazka_password
DATABASE_URL=postgresql+asyncpg://stazka_user:stazka_password@db:5432/stazka

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# ─── FastAPI ─────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change_me_in_production

# ─── App ─────────────────────────────────────────────────────────────────────
# production = CORS off (handled by nginx), anything else = CORS on for localhost dev
APP_ENV=production
DEBUG=true
LOG_LEVEL=INFO

# ─── Career Week (временный модуль) ──────────────────────────────────────────
CAREER_WEEK_ENABLED=false
CAREER_WEEK_ADMIN_IDS=5645685337
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
